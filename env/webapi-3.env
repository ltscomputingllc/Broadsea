# OHDSI WebAPI 3.0 configuration (env-var based) — loaded via env_file in docker-compose.yml.
# Self-contained source of truth for the webapi-3 profile; NOT read from the 2.x .env.
# Use literal values here — do not rely on ${...} expansion in this file.
# NOTE: the DB password is intentionally NOT here — it is injected from the Docker secret
# WEBAPI_DATASOURCE_PASSWORD by webapi/docker-entrypoint-3.sh at container start.

SERVER_SERVLET_CONTEXT_PATH=/WebAPI

# Datasource
DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
DATASOURCE_URL=jdbc:postgresql://broadsea-atlasdb:5432/postgres
DATASOURCE_USERNAME=postgres
DATASOURCE_OHDSI_SCHEMA=webapi
SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA=webapi
SPRING_BATCH_REPOSITORY_TABLEPREFIX=webapi.BATCH_

# Flyway (Spring Boot names). flyway_schema_history matches the broadsea-atlasdb image.
SPRING_FLYWAY_URL=jdbc:postgresql://broadsea-atlasdb:5432/postgres
SPRING_FLYWAY_USER=postgres
SPRING_FLYWAY_SCHEMAS=webapi
SPRING_FLYWAY_PLACEHOLDERS_OHDSISCHEMA=webapi
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_TABLE=flyway_schema_history

SOLR_ENDPOINT=

LOGGING_LEVEL_ROOT=info
LOGGING_LEVEL_ORG_OHDSI=info

# Security / DB auth. The auth_user table lives in webapi_security and is seeded
# from the Broadsea atlasdb DB-auth users. Password is injected by the entrypoint.
SECURITY_AUTH_DB_ENABLED=true
SECURITY_AUTH_DB_DATASOURCE_DRIVERCLASSNAME=org.postgresql.Driver
SECURITY_AUTH_DB_DATASOURCE_URL=jdbc:postgresql://broadsea-atlasdb:5432/postgres
SECURITY_AUTH_DB_DATASOURCE_USERNAME=postgres
SECURITY_AUTH_DB_DATASOURCE_SCHEMA=webapi_security
# SECURITY_JWT_SECRET is injected from the Docker secret by webapi/docker-entrypoint-3.sh
# (secrets/webapi/SECURITY_JWT_SECRET) — intentionally not set here as plaintext.
SECURITY_CORS_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost
