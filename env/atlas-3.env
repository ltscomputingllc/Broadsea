# OHDSI Atlas 3.0 configuration (env-var based) — loaded via env_file in docker-compose.yml.
# Self-contained source of truth for the atlas-3 profile; NOT read from the 2.x .env.
# Values are literal — docker compose does NOT expand ${...} inside an env_file.

# WebAPI URL resolution (dynamic = browser derives http(s)://<host>/WebAPI/ from the page)
USE_DYNAMIC_WEBAPI_URL=true
DYNAMIC_WEBAPI_SUFFIX=/WebAPI/
# Only used if USE_DYNAMIC_WEBAPI_URL=false; via Traefik on this local stack
WEBAPI_URL=http://127.0.0.1/WebAPI/

# Core Atlas 3.0 settings (image's own variable names)
ATLAS_INSTANCE_NAME=Broadsea
ATLAS_COHORT_COMPARISON_RESULTS_ENABLED=false
ATLAS_USER_AUTH_ENABLED=false
ATLAS_PLP_RESULTS_ENABLED=false
ATLAS_CLEAR_LOCAL_STORAGE=false
ATLAS_DISABLE_BROWSER_CHECK=false
ATLAS_ENABLE_PERMISSIONS_MGMT=false
ATLAS_CACHE_SOURCES=false
ATLAS_POLL_INTERVAL=60000
ATLAS_SKIP_LOGIN=false
ATLAS_USE_EXECUTION_ENGINE=false
ATLAS_VIEW_PROFILE_DATES=false
ATLAS_ENABLE_COSTS=false
ATLAS_SUPPORT_URL=https://github.com/ohdsi/atlas/issues
ATLAS_SUPPORT_MAIL=atlasadmin@your.org
ATLAS_FEEDBACK_CONTACTS=For access or questions concerning the Atlas application please contact:
ATLAS_FEEDBACK_HTML=
ATLAS_COMPANYINFO_HTML=
ATLAS_COMPANYINFO_SHOW=true
ATLAS_DEFAULT_LOCALE=en
ATLAS_ENABLE_TANDCS=true
ATLAS_ENABLE_PERSONCOUNT=true
ATLAS_ENABLE_TAGGING_SECTION=false
ATLAS_REFRESH_TOKEN_THRESHOLD=240

# Security: the image defaults the legacy ATLAS_SECURITY_PROVIDER_ENABLED to TRUE (it pushes
# a "none" provider for existing broadsea implementations). Disable for the no-auth smoke
# test, plus all provider families.
ATLAS_SECURITY_PROVIDER_ENABLED=false
ATLAS_SECURITY_WIN_PROVIDER_ENABLED=false
ATLAS_SECURITY_KERB_PROVIDER_ENABLED=false
ATLAS_SECURITY_OID_PROVIDER_ENABLED=false
ATLAS_SECURITY_GGL_PROVIDER_ENABLED=false
ATLAS_SECURITY_FB_PROVIDER_ENABLED=false
ATLAS_SECURITY_GH_PROVIDER_ENABLED=false
ATLAS_SECURITY_DB_PROVIDER_ENABLED=false
ATLAS_SECURITY_LDAP_PROVIDER_ENABLED=false
ATLAS_SECURITY_SAML_PROVIDER_ENABLED=false
ATLAS_SECURITY_AD_PROVIDER_ENABLED=false
